# Smart City ANPR System — Environment Variables
# Copy this file to .env and fill in your credentials
# Never commit .env to version control

# SMTP Email Alerts
ANPR_ALERT_SMTP_HOST=smtp.gmail.com
ANPR_ALERT_SMTP_PORT=587
ANPR_ALERT_SMTP_USER=your_email@gmail.com
ANPR_ALERT_SMTP_PASS=your_app_password
ANPR_ALERT_EMAIL_FROM=your_email@gmail.com
ANPR_ALERT_EMAIL_TO=traffic.authority@gov.in

# Twilio SMS Alerts
ANPR_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANPR_TWILIO_TOKEN=your_auth_token_here
ANPR_ALERT_SMS_TO=+919876543210
ANPR_ALERT_SMS_FROM=+14155552671
